# OBS 服务器地址与串流密钥只在启动终端 / journalctl 中显示，网页和 API 不再返回
# Web 观看页端口（仅本机/反向代理访问，不要直接暴露公网）
HTTP_PORT=3100
# OBS RTMP 推流端口
RTMP_PORT=1935
# 公网部署务必设置，OBS 串流密钥写为 "频道名?token=这里的值"
STREAM_TOKEN=change-me-to-a-long-random-string
# 服务器实际上行带宽（Mbps），用于建议码率与观看人数估算；<=10 自动启用省流轮询
UPLINK_MBPS=8
# 最多同时转发的频道数，每个频道一个轻量 ffmpeg 进程
MAX_STREAMS=3
# HLS 分片时长与保留分片数（越小延迟越低，磁盘/内存占用也越小）
HLS_TIME=2
HLS_LIST_SIZE=5
# 小服务器建议写内存盘，避免频繁写 SSD；留空则写 public/hls
HLS_DIR=/dev/shm/obs-live-hls
# 可选：ffmpeg 可执行文件路径
# FFMPEG=/usr/bin/ffmpeg
